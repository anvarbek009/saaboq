# Saaboq Environment Configuration Example
# Copy this file to .env.local to configure real Supabase & Cloudflare services

# App configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (PostgreSQL, Auth, Storage, Realtime)
# Get these from https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudflare Stream (Direct Video Uploads & Encoding)
# Get these from Cloudflare Dashboard -> Stream -> API
CLOUDFLARE_STREAM_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_STREAM_API_TOKEN=your_cloudflare_stream_api_token
